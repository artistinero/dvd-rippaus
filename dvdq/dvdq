#!/usr/bin/env bash
# dvdq — DVD-rippaus/enkoodausjärjestelmän ydin-CLI (UUSI_ARKKITEHTUURI_suunnitelma.md).
# Ei-interaktiivinen ydin (§1): ottaa argumentit, tulostaa koneluettavan kuoren (§6.1).
# EI set -e (§8.1). Virheet → {"ok":false,...} + rc≠0.
set -uo pipefail

DVDQ_HOME=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
source "$DVDQ_HOME/lib/common.sh"
source "$DVDQ_HOME/lib/jobs.sh"
source "$DVDQ_HOME/lib/commands.sh"
source "$DVDQ_HOME/lib/thermal.sh"
source "$DVDQ_HOME/lib/dispatch.sh"

usage() {
  cat >&2 <<'EOF'
dvdq <komento> [argumentit]
  enqueue --source S --title N --kind K --name NIMI [--year Y --season SS --episode EE]
          [--role main|extra] [--force] [metadata-liput]
  skip <id> | unskip <id> | retry <id>
  status [--json]
  reconcile
Komennot palauttavat JSON-kuoren stdoutiin (§6.1). Lisää komentoja tulee vaiheittain.
EOF
}

# Komennot jotka EIVÄT tarvitse NAS-writable-validointia (§5.4): lukukomennot + paikallista tilaa
# koskevat palvelut. `thermal` koskee vain lokaalia STATEa (heartbeat, job-liput) → ei saa kaatua/
# jäädä odottamaan NAS-statia, jottei lämpöturva katoa NAS-katkon takia.
_is_readonly_cmd() { case $1 in status|review-problematic|reconcile|thermal) return 0;; *) return 1;; esac; }

main() {
  local cmd=${1-}; [ $# -gt 0 ] && shift || true
  [ -n "$cmd" ] || { usage; return 2; }

  config_load
  config_validate_common || return 1          # AINA (tyypit/välit/ristiriidat)
  state_init_dirs || { err_out dest_unwritable STATE "$STATE" "luotavissa"; return 1; }
  if ! _is_readonly_cmd "$cmd"; then
    config_validate_writable || return 1        # vain kirjoittajille (NAS-stat)
  fi

  case $cmd in
    enqueue)  cmd_enqueue "$@" ;;
    skip)     cmd_skip "$@" ;;
    unskip)   cmd_unskip "$@" ;;
    retry)    cmd_retry "$@" ;;
    status)   cmd_status "$@" ;;
    dispatch) cmd_dispatch "$@" ;;
    thermal)  [ "${1-}" = --backup ] && thermal_watchdog backup || thermal_watchdog main ;;
    reconcile) reconcile ;;
    -h|--help|help) usage; return 0 ;;
    *) err_out bad_state command "$cmd" "tunnettu komento"; usage; return 1 ;;
  esac
}
main "$@"
