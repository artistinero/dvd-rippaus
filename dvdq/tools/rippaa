#!/usr/bin/env bash
# dvdq/tools/rippaa — interaktiivinen rippaus. OIKEA JÄRJESTYS: kysy tiedot ENSIN (levyn nopeasta
# sisällysluettelosta), sitten rippaa valvomatta, sitten enqueuaa itsestään → voit poistua.
#   1. sulje kelkka + lue tittelit (lsdvd, sekunteja, EI kopioi levyä)
#   2. näytä tittelit kestoineen + pääelokuva-ehdotus, kysy tyyppi/nimi/pää/ekstrat
#   3. dvdbackup kopioi koko levyn (10–30 min, VALVOMATTA)
#   4. enqueuaa valitut tittelit metadatoineen → dispatcher-daemon enkoodaa automaattisesti
# Testihook: DVDQ_RIPPAA_SCANFILE=<valmis scans-json> → ohita levy, tee vain ask+enqueue (logiikan testaus).
set -uo pipefail
_u=$(locale -a 2>/dev/null | grep -iE '^C\.utf-?8$' | head -1); export LC_ALL="${_u:-C}"; unset _u
HERE=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
DVDQ="$HERE/../dvdq"
source "$HERE/../lib/common.sh"; source "$HERE/../lib/jobs.sh"
source "$HERE/../lib/scan.sh"; source "$HERE/../lib/rip.sh"
config_load
DEV="${1:-/dev/sr1}"

# _lsdvd_titles <device> → "titteli kesto_s luvut" per rivi (nopea, ei kopioi). Luvut = chapters
# (parhaan kyvyn mukaan; tyhjä jos ei jäsenny). Tyhjä jos ei lue.
_lsdvd_titles() {
  lsdvd "$1" 2>/dev/null | sed -n 's/^Title: 0*\([0-9]\+\), Length: \([0-9]\+\):\([0-9]\+\):\([0-9]\+\).*/&/p' \
    | while read -r line; do
        t=$(printf '%s' "$line" | sed -n 's/^Title: 0*\([0-9]\+\),.*/\1/p')
        hms=$(printf '%s' "$line" | sed -n 's/.*Length: \([0-9]\+\):\([0-9]\+\):\([0-9]\+\).*/\1 \2 \3/p')
        ch=$(printf '%s' "$line" | sed -n 's/.*Chapters: 0*\([0-9]\+\).*/\1/p')
        # 10#-etuliite pakottaa kymmenkantaan: lsdvd:n "08"/"09" ovat kelvottomia oktaalilukuja muuten.
        set -- $hms; printf '%s %d %s\n' "$t" $(( 10#${1:-0}*3600 + 10#${2:-0}*60 + 10#${3:-0} )) "${ch:-0}"
      done
}

# _disc_label <device> → levyn nimiöstä (lsdvd "Disc Title:") NIMIEHDOTUS: alaviivat väleiksi,
# yleiset roskatunnisteet (DVD9/NTSC/DISC1…) pois, sanat title-caseen. Vain EHDOTUS — käyttäjä
# vahvistaa/korjaa (nimiö on usein karkea/lyhennetty, esim. jakelijatagi).
_disc_label() {
  lsdvd "$1" 2>/dev/null | sed -n 's/^Disc Title: //p' | head -1 \
    | sed -E 's/_/ /g; s/\b(DVD ?[59]?|BLURAY|NTSC|PAL|DISC ?[0-9]+|D[0-9]+|SIDE ?[AB]|R[0-9])\b//gi; s/  +/ /g; s/^ +//; s/ +$//' \
    | awk '{for(i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) tolower(substr($i,2)); print}'
}

# --- kysy luokittelu (yhteinen, käyttää titles-listaa "titteli kesto_s") ----------------------
# asettaa globaalit: kind name year season ep0 mainsel eps extras
ask_classification() {
  local titles=$1 mainsug=$2 label=${3:-}
  echo "════════ Levyn tittelit ════════"
  printf '%s\n' "$titles" | sort -k2 -rn | while read -r t d c; do
    local mark
    if [ "$t" = "$mainsug" ]; then mark="⟵ pisin (pääelokuva-ehdotus)"
    elif [ "${d:-0}" -lt 60 ]; then mark="(lyhyt — todennäk. VALIKKO, jätetään pois)"
    else mark="(sisältöä — todennäk. ekstra)"; fi
    printf '  Titteli %-3s %4d min%s  %s\n' "$t" "$((d/60))" "$([ -n "$c" ] && [ "$c" != 0 ] && printf ', %s lukua' "$c")" "$mark"
  done
  [ -n "$label" ] && echo "  Levyn nimiö → nimiehdotus: $label"
  echo "  (Kestosta ei voi varmasti tietää mikä titteli on. Oletus ottaa KAIKEN sisällön —"
  echo "   turha ekstra on helppo poistaa, mutta puuttuva vaatii koko levyn uudelleen.)"
  echo "════════════════════════════════"
  read -rp "Tyyppi [movie/series/doc/music/misc] (oletus movie): " kind; kind=${kind:-movie}
  # Nimiehdotus levyn nimiöstä oletuksena — Enter hyväksyy, tai kirjoita oikea.
  read -rp "Nimi${label:+ [$label]}: " name; name=${name:-$label}
  while [ -z "$name" ]; do read -rp "Nimi (pakollinen): " name; done
  year=""; season=""; ep0=1; mainsel=""; eps=""; extras=""
  case $kind in
    movie|doc) read -rp "Vuosi (valinnainen): " year ;;
    series)    read -rp "Kausi (numero): " season; read -rp "Ensimmäisen jakson numero [1]: " ep0; ep0=${ep0:-1} ;;
  esac
  local mind="${CFG[MIN_DURATION]}"                 # jaksojen kynnys (pitkät)
  local emin="${DVDQ_EXTRA_MIN_S:-60}"              # EKSTROJEN kynnys: 60 s (ohittaa 0-min valikot,
  # ottaa oikeat lyhyet ekstrat kuten 2–4 min featuretit). Säädettävissä DVDQ_EXTRA_MIN_S:llä.
  if [ "$kind" = series ]; then
    read -rp "Jakso-tittelit järjestyksessä (välilyönnein, tyhjä = kaikki >= $((mind/60)) min): " eps
    [ -z "$eps" ] && eps=$(printf '%s\n' "$titles" | awk -v m="$mind" '$2>=m{print $1}' | sort -n | tr '\n' ' ')
    read -rp "Ekstra-tittelit (välilyönnein, 'auto' = kaikki muut >= ${emin} s, tyhjä = ei ekstroja): " extras
    [ "$extras" = auto ] && extras=$(printf '%s\n' "$titles" | awk -v m="$emin" '$2>=m{print $1}' | sort -n | tr '\n' ' ')
  else
    read -rp "Pääelokuvan titteli [${mainsug}]: " mainsel; mainsel=${mainsel:-$mainsug}
    # INKLUSIIVINEN OLETUS: Enter = kaikki sisältötittelit (>= ${emin}s, valikot pois). 'ei' = ei ekstroja.
    read -rp "Ekstra-tittelit — Enter = KAIKKI sisältö (suositus), 'ei' = ei mitään, tai numerot: " extras
    case "${extras}" in
      ""|auto) extras=$(printf '%s\n' "$titles" | awk -v m="$emin" -v x="$mainsel" '$2>=m && $1!=x{print $1}' | sort -n | tr '\n' ' ') ;;
      ei|EI|none|0) extras="" ;;
    esac
  fi
  echo "──────── Yhteenveto ────────"
  echo "  Tyyppi: $kind   Nimi: $name   ${year:+Vuosi: $year }${season:+Kausi: $season (jaksot alkaen $ep0)}"
  [ "$kind" = series ] && echo "  Jaksot (tittelit): $eps" || echo "  Pääelokuva: titteli $mainsel"
  echo "  Ekstrat (tittelit): ${extras:-—}"
  echo "────────────────────────────"
  local c; read -rp "Aloitetaanko rippaus näillä tiedoilla? [K/e]: " c; case ${c:-K} in [eEnN]*) echo "Peruttu."; exit 0;; esac
}

# _enq <source> <title> <role> [episode] — poimii tittelin metadatan (scan_title ripatuista VOBeista)
# ja enqueuaa. Metadata → mitattu ETA + raitapolitiikka toimivat.
_enq() {
  local src=$1 t=$2 role=$3 epi=${4:-} ti
  ti=$(scan_title "$src" "$t" 2>/dev/null)
  local st; st=$(printf '%s' "$ti" | jq -r '.status // "ok"' 2>/dev/null)
  local -a a=(--source "$src" --title "$t" --kind "$kind" --name "$name" --role "$role")
  [ -n "$year" ]   && a+=(--year "$year")
  [ -n "$season" ] && a+=(--season "$season")
  [ -n "$epi" ]    && a+=(--episode "$epi")
  if [ "$st" = ok ]; then
    local d w h dar fps fmt il crop subs aud
    d=$(jq -r '.duration_s // empty' <<<"$ti"); w=$(jq -r '.width // empty' <<<"$ti"); h=$(jq -r '.height // empty' <<<"$ti")
    dar=$(jq -r '.dar // empty' <<<"$ti"); fps=$(jq -r '.fps // empty' <<<"$ti"); fmt=$(jq -r '.format // empty' <<<"$ti")
    il=$(jq -r '.interlaced // false' <<<"$ti"); crop=$(jq -r '.crop // empty' <<<"$ti")
    subs=$(jq -c '.src_subs // []' <<<"$ti"); aud=$(jq -c '.src_audio // []' <<<"$ti")
    [ -n "$d" ] && a+=(--duration "$d"); [ -n "$w" ] && a+=(--width "$w"); [ -n "$h" ] && a+=(--height "$h")
    [ -n "$dar" ] && a+=(--dar "$dar"); [ -n "$fps" ] && a+=(--fps "$fps"); [ -n "$fmt" ] && a+=(--format "$fmt")
    a+=(--interlaced "$il"); [ -n "$crop" ] && a+=(--crop "$crop"); a+=(--src-subs "$subs" --src-audio "$aud")
  fi
  local r; r=$("$DVDQ" enqueue "${a[@]}" 2>&1)
  if [ "$(printf '%s' "$r" | jq -r '.ok // false' 2>/dev/null)" = true ]; then
    echo "  ✓ titteli $t → $role $([ -n "$epi" ] && echo "(jakso $epi)")"
  else echo "  ✗ titteli $t: $(printf '%s' "$r" | jq -r '.error // .' 2>/dev/null)"; fi
}

enqueue_selected() {   # <source>
  local src=$1 n=0 t epi
  if [ "$kind" = series ]; then
    epi=$ep0; for t in $eps; do _enq "$src" "$t" main "$epi"; epi=$((epi+1)); n=$((n+1)); done
  else
    [ -n "$mainsel" ] && { _enq "$src" "$mainsel" main; n=$((n+1)); }
  fi
  for t in $extras; do _enq "$src" "$t" extra; n=$((n+1)); done
  echo "Valmis: $n titteliä lisätty jonoon. Dispatcher enkoodaa automaattisesti — seuraa: dvdq-tila"
}

# ══════════ TESTIHOOK: valmis scanfile → vain ask+enqueue ══════════
if [ -n "${DVDQ_RIPPAA_SCANFILE:-}" ]; then
  sf="$DVDQ_RIPPAA_SCANFILE"; src=$(jq -r '.source' "$sf")
  titles=$(jq -r '.titles[]|select(.status=="ok")|"\(.title) \(.duration_s // 0)"' "$sf")
  mainsug=$(jq -r '.main_suggestion // (.titles|map(select(.status=="ok"))|max_by(.duration_s).title)' "$sf")
  ask_classification "$titles" "$mainsug" "$(jq -r '.volume // ""' "$sf")"
  enqueue_selected "$src"; exit 0
fi

# ══════════ 1. sisällysluettelo ENSIN (lsdvd, nopea) ══════════
echo "Suljetaan kelkka ja luetaan levyn sisällysluettelo ($DEV)..." >&2
_ensure_disc "$DEV" || { echo "Ei luettavaa levyä 60 s:ssa (kelkka auki tai tyhjä?)." >&2; exit 1; }
titles=$(_lsdvd_titles "$DEV")
[ -n "$titles" ] || { echo "Tittelien luku epäonnistui (viallinen/kopiosuojattu levy?)." >&2; exit 1; }
mainsug=$(printf '%s\n' "$titles" | sort -k2 -n | tail -1 | awk '{print $1}')

# ══════════ 2. kysy tiedot (ENNEN pitkää rippausta) ══════════
ask_classification "$titles" "$mainsug" "$(_disc_label "$DEV")"

# ══════════ 3. dvdbackup VALVOMATTA (nyt voit poistua) ══════════
echo "──────────────────────────────"
echo "Rippaus alkaa — voit POISTUA. Loppu tapahtuu itsestään (rippaus → jono → enkoodaus)."
discdir=$(next_disc_dir)
printf 'dvdbackup kopioi koko levyn (10–30 min)...\n' >&2
( rip_backup "$DEV" "$discdir" ) &
_rp=$!; _s=0
while kill -0 "$_rp" 2>/dev/null; do
  sz=$(du -sh "$discdir" 2>/dev/null | cut -f1)
  printf '\r  …ripataan  %dm%02ds  kopioitu %s   ' $((_s/60)) $((_s%60)) "${sz:-0}" >&2
  sleep 5; _s=$((_s+5))
done
printf '\r%70s\r' '' >&2; wait "$_rp" || { echo "dvdbackup epäonnistui." >&2; exit 1; }
if [ "${RIP_READ_ERRORS:-0}" -gt "${CFG[READ_ERROR_MAX]}" ]; then
  echo "VAROITUS: $RIP_READ_ERRORS lukuvirhettä (> ${CFG[READ_ERROR_MAX]}) — levy voi olla vaurioitunut." >&2
fi
vts=$(find "$discdir" -type d -iname VIDEO_TS 2>/dev/null | head -1)
[ -n "$vts" ] || { echo "VIDEO_TS ei löytynyt rippauksen jälkeen." >&2; exit 1; }

# ══════════ RIPPAUS VALMIS → AVAA KELKKA (huomaat sen; levyä ei enää tarvita) ══════════
command -v eject >/dev/null 2>&1 && eject "$DEV" 2>/dev/null
echo "✔ RIPPAUS VALMIS — kelkka avattu, voit ottaa levyn / vaihtaa seuraavan."

# ══════════ 4. enqueue valitut (metadata ripatuista VOBeista) ══════════
echo "Lisätään tittelit jonoon (enkoodaus jatkuu taustalla, levyä ei tarvita)..."
enqueue_selected "$(dirname "$vts")"
