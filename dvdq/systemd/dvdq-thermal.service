# dvdq lämpövahti — ERILLINEN prosessi (§8.2). Heartbeat lukon ulkopuolella; STOP/CONT/kill
# enkooderiryhmille. Käyttöön: systemctl enable --now dvdq-thermal
[Unit]
Description=dvdq thermal watchdog
After=network-online.target

[Service]
Type=simple
User=keitsi
ExecStart=/usr/local/lib/dvdq/dvdq thermal
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
